{
  "name": "3d-ice",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle:compat": "node scripts/build_compat_bundle.mjs",
    "smoke:compat": "node scripts/smoke_compat_bundle.mjs",
    "prepare:refined-basin-search": "node scripts/prepare_refined_basin_search.mjs",
    "test:polar-features": "node --experimental-test-coverage --test-coverage-include=static/tools/js/polar-feature-search.js --test-coverage-include=static/tools/js/polar-feature-label-style.js --test-coverage-include=static/tools/js/polar-refined-basins.js --test-coverage-lines=80 --test tests/js/polar-features.test.mjs",
    "test:gia-rebound": "node --experimental-test-coverage --test-coverage-include=static/tools/js/gia-rebound.js --test-coverage-include=static/tools/js/gia-grid.js --test-coverage-include=static/tools/js/fft2d.js --test-coverage-lines=80 --test tests/js/gia-rebound.test.mjs tests/js/gia-point-load.test.mjs",
    "test:ice-projection": "node --experimental-test-coverage --test-coverage-include=static/tools/js/ice-projection.js --test-coverage-lines=80 --test tests/js/ice-projection.test.mjs",
    "test:data-contract": "node --experimental-test-coverage --test-coverage-include=static/tools/js/data-contract.js --test-coverage-lines=80 --test tests/js/data-contract.test.mjs",
    "test:editions": "node --experimental-test-coverage --test-coverage-include=static/tools/js/editions.js --test-coverage-include=static/tools/js/polar-projection.js --test-coverage-include=static/tools/js/explore-tour.js --test-coverage-include=static/tools/js/explore-content.js --test-coverage-lines=80 --test tests/js/editions.test.mjs tests/js/polar-projection.test.mjs tests/js/explore-tour.test.mjs tests/js/explore-content.test.mjs",
    "test:examples": "node --test tests/js/examples.test.mjs",
    "test:locale": "node --test tests/js/locale-coverage.test.mjs",
    "test:js": "npm run test:polar-features && npm run test:gia-rebound && npm run test:ice-projection && npm run test:data-contract && npm run test:editions && npm run test:examples && npm run test:locale",
    "example:rebound": "node examples/isostatic-rebound.mjs"
  }
}
